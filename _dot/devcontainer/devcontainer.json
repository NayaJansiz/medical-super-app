{
  "name": "Medical Super App",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20", "pnpmVersion": "9" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": {
    "DATABASE_URL": "postgresql://postgres:postgres@db:5432/app",
    "APP_ENV": "development",
    "AI_PROVIDER": "mock"
  },
  "postCreateCommand": "pip install --user uv && uv sync && pnpm install && uv run alembic -c backend/alembic.ini upgrade head",
  "forwardPorts": [5000, 8000],
  "portsAttributes": {
    "5000": { "label": "Web app" },
    "8000": { "label": "API" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}
